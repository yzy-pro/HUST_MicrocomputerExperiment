#!/usr/bin/env bash
set -euo pipefail

REAL_SDCC="/home/yzy/.eide/tools/sdcc_mcs51/sdcc-4.5.0-with-binutils/bin/sdcc"

is_link=1
for arg in "$@"; do
    case "$arg" in
        -c|--compile-only|-S|--preprocessonly|--syntax-only|--c1mode)
            is_link=0
            ;;
    esac
done

if [[ "$is_link" -eq 1 ]]; then
    new_args=()
    for arg in "$@"; do
        if [[ "$arg" == *.rel && -f "$arg" ]]; then
            obj="${arg%.rel}.o"
            if [[ ! -f "$obj" || "$arg" -nt "$obj" ]]; then
                cp -f "$arg" "$obj"
            fi
            new_args+=("$obj")
        else
            new_args+=("$arg")
        fi
    done
    exec "$REAL_SDCC" "${new_args[@]}"
else
    exec "$REAL_SDCC" "$@"
fi
